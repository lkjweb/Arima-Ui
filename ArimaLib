-- ArimaUI.lua
-- Standalone Roblox UI Library

local ArimaUI = {}
ArimaUI.__index = ArimaUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Themes = {
    Dark = {
        Background = Color3.fromRGB(22,22,25),
        Sidebar = Color3.fromRGB(17,17,20),
        Element = Color3.fromRGB(30,30,34),
        Text = Color3.fromRGB(245,245,245),
        SubText = Color3.fromRGB(160,160,165),
        Accent = Color3.fromRGB(180,35,45)
    },

    Gray = {
        Background = Color3.fromRGB(75,75,80),
        Sidebar = Color3.fromRGB(58,58,62),
        Element = Color3.fromRGB(88,88,93),
        Text = Color3.fromRGB(245,245,245),
        SubText = Color3.fromRGB(205,205,210),
        Accent = Color3.fromRGB(180,35,45)
    },

    White = {
        Background = Color3.fromRGB(235,235,238),
        Sidebar = Color3.fromRGB(215,215,220),
        Element = Color3.fromRGB(250,250,250),
        Text = Color3.fromRGB(25,25,28),
        SubText = Color3.fromRGB(90,90,95),
        Accent = Color3.fromRGB(170,35,45)
    }
}

local Theme = Themes.Dark

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

local function Make(class, props, parent)
    local obj = Instance.new(class)

    for k,v in pairs(props or {}) do
        obj[k] = v
    end

    obj.Parent = parent
    return obj
end

function ArimaUI:CreateWindow(options)

    options = options or {}

    local gui = Make("ScreenGui", {
        Name = "ArimaUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true
    }, PlayerGui)

    local Main = Make("Frame", {
        Size = UDim2.fromOffset(720,460),
        Position = UDim2.new(.5,-360,.5,-230),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    }, gui)

    Corner(Main,12)

    -- =========================
    -- ARIMA BACKGROUND
    -- =========================

    local Background = Make("ImageLabel", {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Image = options.BackgroundImage or "",
        ImageTransparency = .72,
        ScaleType = Enum.ScaleType.Crop
    }, Main)

    Corner(Background,12)

    -- =========================
    -- TOP BAR
    -- =========================

    local Top = Make("Frame", {
        Size = UDim2.new(1,0,0,45),
        BackgroundTransparency = 1
    }, Main)

    local Title = Make("TextLabel", {
        Position = UDim2.fromOffset(15,0),
        Size = UDim2.new(1,-120,1,0),
        BackgroundTransparency = 1,
        Text = options.Name or "Arima UI",
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Top)

    -- MINIMIZE

    local Minimize = Make("TextButton", {
        Position = UDim2.new(1,-75,0,8),
        Size = UDim2.fromOffset(30,30),
        BackgroundColor3 = Theme.Element,
        Text = "—",
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0
    }, Top)

    Corner(Minimize,7)

    -- CLOSE

    local Close = Make("TextButton", {
        Position = UDim2.new(1,-40,0,8),
        Size = UDim2.fromOffset(30,30),
        BackgroundColor3 = Theme.Element,
        Text = "×",
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        BorderSizePixel = 0
    }, Top)

    Corner(Close,7)

    -- =========================
    -- SIDEBAR
    -- =========================

    local Sidebar = Make("Frame", {
        Position = UDim2.fromOffset(10,55),
        Size = UDim2.new(0,150,1,-65),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, Main)

    Corner(Sidebar,10)

local SideLayout = Make("UIListLayout", {
        Padding = UDim.new(0,6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Sidebar)

    Make("UIPadding", {
        PaddingTop = UDim.new(0,10),
        PaddingLeft = UDim.new(0,8),
        PaddingRight = UDim.new(0,8)
    }, Sidebar)

    -- =========================
    -- CONTENT
    -- =========================

    local Content = Make("Frame", {
        Position = UDim2.fromOffset(170,55),
        Size = UDim2.new(1,-180,1,-65),
        BackgroundTransparency = 1
    }, Main)

    local Tabs = {}

    local function CreateTab(name, icon)

        local Button = Make("TextButton", {
            Size = UDim2.new(1,0,0,38),
            BackgroundColor3 = Theme.Element,
            Text = (icon or "•") .. "  " .. name,
            TextColor3 = Theme.SubText,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            BorderSizePixel = 0
        }, Sidebar)

        Corner(Button,7)

        local Page = Make("ScrollingFrame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false
        }, Content)

        Make("UIPadding", {
            PaddingTop = UDim.new(0,5),
            PaddingLeft = UDim.new(0,5),
            PaddingRight = UDim.new(0,8),
            PaddingBottom = UDim.new(0,10)
        }, Page)

        Make("UIListLayout", {
            Padding = UDim.new(0,8)
        }, Page)

        local Tab = {
            Button = Button,
            Page = Page
        }

        function Tab:CreateToggle(data)

            local state = data.CurrentValue or false

            local holder = Make("Frame", {
                Size = UDim2.new(1,0,0,50),
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0
            }, Page)

            Corner(holder,8)

            Make("TextLabel", {
                Position = UDim2.fromOffset(14,0),
                Size = UDim2.new(1,-75,1,0),
                BackgroundTransparency = 1,
                Text = data.Name or "Toggle",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, holder)

            local toggle = Make("TextButton", {
                Position = UDim2.new(1,-55,.5,-12),
                Size = UDim2.fromOffset(42,24),
                BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(65,65,70),
                Text = "",
                BorderSizePixel = 0
            }, holder)

            Corner(toggle,12)

            toggle.MouseButton1Click:Connect(function()
                state = not state

                TweenService:Create(
                    toggle,
                    TweenInfo.new(.15),
                    {
                        BackgroundColor3 =
                            state and Theme.Accent
                            or Color3.fromRGB(65,65,70)
                    }
                ):Play()

                if data.Callback then
                    data.Callback(state)
                end
            end)

            return {
                Set = function(_, value)
                    state = value
                    if data.Callback then
                        data.Callback(value)
                    end
                end
            }
        end

        function Tab:CreateButton(data)

            local button = Make("TextButton", {
                Size = UDim2.new(1,0,0,45),
                BackgroundColor3 = Theme.Element,
                Text = data.Name or "Button",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                BorderSizePixel = 0
            }, Page)

            Corner(button,8)

button.MouseButton1Click:Connect(function()
                if data.Callback then
                    data.Callback()
                end
            end)

            return button
        end

        function Tab:CreateLabel(text)

            return Make("TextLabel", {
                Size = UDim2.new(1,0,0,30),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.SubText,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Page)
        end

        function Tab:CreateTextBox(data)

            local box = Make("TextBox", {
                Size = UDim2.new(1,0,0,45),
                BackgroundColor3 = Theme.Element,
                Text = "",
                PlaceholderText = data.Placeholder or "",
                PlaceholderColor3 = Theme.SubText,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                ClearTextOnFocus = false,
                BorderSizePixel = 0
            }, Page)

            Corner(box,8)

            box.FocusLost:Connect(function()
                if data.Callback then
                    data.Callback(box.Text)
                end
            end)

            return box
        end

        Tabs[name] = Tab

        Button.MouseButton1Click:Connect(function()

            for _,tab in pairs(Tabs) do
                tab.Page.Visible = false
                tab.Button.BackgroundColor3 = Theme.Element
            end

            Page.Visible = true
            Button.BackgroundColor3 = Theme.Accent
        end)

        return Tab
    end

    -- =========================
    -- DEFAULT TABS
    -- =========================

    local Combat = CreateTab("Combat","⚔")
    local Visuals = CreateTab("Visuals","◉")
    local Character = CreateTab("Character","♙")
    local Settings = CreateTab("Settings","⚙")

    -- SETTINGS

    Settings:CreateLabel("Interface Theme")

    Settings:CreateButton({
        Name = "Dark",
        Callback = function()
            Theme = Themes.Dark
        end
    })

    Settings:CreateButton({
        Name = "Gray",
        Callback = function()
            Theme = Themes.Gray
        end
    })

    Settings:CreateButton({
        Name = "White",
        Callback = function()
            Theme = Themes.White
        end
    })

    -- FIRST TAB

    Combat.Button.BackgroundColor3 = Theme.Accent
    Combat.Page.Visible = true

    -- =========================
    -- DRAG
    -- =========================

    local dragging = false
    local dragStart
    local startPos

    Top.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)

        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- =========================
    -- MINIMIZE
    -- =========================

local Mini = Make("TextButton", {
        Size = UDim2.fromOffset(55,55),
        Position = Main.Position,
        BackgroundColor3 = Theme.Element,
        Text = "A",
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Visible = false,
        BorderSizePixel = 0
    }, gui)

    Corner(Mini,12)

    Minimize.MouseButton1Click:Connect(function()
        Mini.Position = UDim2.fromOffset(
            Main.AbsolutePosition.X,
            Main.AbsolutePosition.Y
        )

        Main.Visible = false
        Mini.Visible = true
    end)

    Mini.MouseButton1Click:Connect(function()
        Main.Visible = true
        Mini.Visible = false
    end)

    Close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    return {
        Window = Main,
        Combat = Combat,
        Visuals = Visuals,
        Character = Character,
        Settings = Settings,
        Destroy = function()
            gui:Destroy()
        end
    }
end

return ArimaUI
